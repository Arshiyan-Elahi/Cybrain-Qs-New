# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cybrain:cybrain_dev@localhost:5432/cybrain_qs

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Local LLM ------------------------------------------------------------
# No cloud provider, no API key. Point this at whatever you run locally.
#
# Ollama (default):
#   ollama pull llama3.1:8b
#   ollama pull nomic-embed-text
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_CHAT_MODEL=llama3.1:8b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=120

# LM Studio / vLLM / llama.cpp / LocalAI instead:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_CHAT_MODEL=<model id the server reports>
#   LLM_EMBEDDING_MODEL=<embedding model id>
#   LLM_EMBEDDING_DIMENSIONS=<that model's output size>
#   LLM_API_KEY=            # only if your server enforces one
