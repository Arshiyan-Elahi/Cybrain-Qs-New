# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cybrain:cybrain_dev@localhost:5432/cybrain_qs

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- AI feature flag / routing --------------------------------------------
AI_FEATURES_ENABLED=true
# auto     = remote when healthy; else Gemini LLM + local Nomic embeddings
# remote   = remote only
# fallback = Gemini LLM + local embeddings only
AI_ROUTING_MODE=auto

# --- Remote AI PC (OpenAI-compatible) ------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://100.79.187.86:1234/v1
LLM_CHAT_MODEL=<remote-chat-model-id>
LLM_EMBEDDING_MODEL=<remote-nomic-embedding-model-id>
LLM_EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=120
# LLM_API_KEY=            # only if your remote server enforces one

# --- Health / failover ----------------------------------------------------
AI_HEALTH_TIMEOUT_SECONDS=2
AI_FAILOVER_COOLDOWN_SECONDS=30
AI_EMBEDDING_COMPAT_MIN_COSINE=0.85

# --- Gemini LLM fallback (server-side only — never expose to frontend) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Local embedding fallback (SentenceTransformers; must stay 768-d) -----
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
LOCAL_EMBEDDING_DIMENSIONS=768

# --- Structured logging ---------------------------------------------------
LOG_LEVEL=INFO
# console (local terminal) or json (machine-readable)
LOG_FORMAT=console
LOG_AI_CONTENT=false
LOG_AI_CONTENT_MAX_CHARS=2000
LOG_REQUESTS=true
LOG_RETRIEVAL=true
LOG_AI_ROUTING=true
LOG_DOCUMENT_PROCESSING=true
